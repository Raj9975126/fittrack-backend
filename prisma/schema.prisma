// FitTrack Unified Database Schema
// Managed by Raj (Database & Architecture Lead)
// Incorporates Part 1 (Anshika), Part 2 (Hartej), and Part 3 (Raj)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// PART 1: User & Exercise Models (Anshika)
// ==========================================

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  password        String
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  profile         UserProfile?
  customExercises Exercise[]        @relation("UserCustomExercises")
  routines        WorkoutRoutine[]
  sessions        WorkoutSession[]
  personalRecords PersonalRecord[]

  @@index([email])
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight          Float?   // in kg or lbs
  height          Float?   // in cm or inches
  fitnessGoals    String?  // e.g. "Hypertrophy", "Strength", "Fat Loss"
  unitSystem      String   @default("kg") // "kg" or "lbs"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Exercise {
  id               String            @id @default(uuid())
  name             String
  muscleGroup      String            // e.g. "Chest", "Back", "Legs", "Shoulders", "Arms", "Core"
  equipment        String            // e.g. "Barbell", "Dumbbell", "Cable", "Machine", "Bodyweight"
  isCustom         Boolean           @default(false)
  createdById      String?
  createdBy        User?             @relation("UserCustomExercises", fields: [createdById], references: [id], onDelete: SetNull)
  instructions     String?
  createdAt        DateTime          @default(now())

  routineExercises RoutineExercise[]
  setLogs          SetLog[]
  personalRecords  PersonalRecord[]

  @@index([muscleGroup])
  @@index([createdById])
}

// ==========================================
// PART 2: Routine & Session Models (Hartej)
// ==========================================

model WorkoutRoutine {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String            // e.g. "Push Day", "Upper Body"
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  exercises   RoutineExercise[]
  sessions    WorkoutSession[]

  @@index([userId])
}

model RoutineExercise {
  id         String         @id @default(uuid())
  routineId  String
  routine    WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order      Int            @default(0)
  targetSets Int            @default(3)
  targetReps Int            @default(10)
  notes      String?

  @@index([routineId])
  @@index([exerciseId])
}

model WorkoutSession {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId   String?
  routine     WorkoutRoutine? @relation(fields: [routineId], references: [id], onDelete: SetNull)
  name        String          // e.g. "Morning Push Workout"
  startTime   DateTime        @default(now())
  endTime     DateTime?
  status      String          @default("IN_PROGRESS") // "IN_PROGRESS", "COMPLETED", "CANCELLED"
  notes       String?
  totalVolume Float           @default(0) // total weight lifted (kg/lbs * reps)
  createdAt   DateTime        @default(now())

  setLogs     SetLog[]

  @@index([userId])
  @@index([routineId])
  @@index([startTime])
}

// ==========================================
// PART 3: Set Logs & PR Models (Raj)
// ==========================================

model SetLog {
  id          String         @id @default(uuid())
  sessionId   String
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setNumber   Int
  weight      Float          // weight used in this set
  reps        Int            // repetitions completed
  rpe         Float?         // Rate of Perceived Exertion (1-10)
  isCompleted Boolean        @default(true)
  isPR        Boolean        @default(false) // flagged if this set established a new PR
  notes       String?
  createdAt   DateTime       @default(now())

  // Optimized indices for history and chart queries
  @@index([sessionId])
  @@index([exerciseId])
  @@index([createdAt])
}

model PersonalRecord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  maxWeight   Float    // heaviest single lift (1RM or max load)
  maxVolume   Float    // best single-set volume (weight * reps)
  achievedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Composite unique constraint: One PR tracking entry per user per exercise
  @@unique([userId, exerciseId])
  @@index([userId])
  @@index([exerciseId])
}
