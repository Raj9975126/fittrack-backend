    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
